# ---------------------------------------------------------------------------
# Root .env — local monorepo convenience (loaded by api/worker via @notif/config).
# For Railway, set variables PER SERVICE using the files under apps/*/
#   apps/api/.env.example
#   apps/worker/.env.example
#   apps/web/.env.example
# ---------------------------------------------------------------------------

DATABASE_URL="postgresql://notif:notif@localhost:5432/notif_portal?schema=public"
REDIS_URL="redis://localhost:6380"
PORTAL_ENCRYPTION_KEY="CHANGE_ME_generate_a_32_byte_base64_key_aaaaaaaaaaaaaaa="

API_HOST="0.0.0.0"
API_PORT="4000"
LOG_LEVEL="info"
FCM_DRIVER="mock"

DEVICE_REGISTRATION_SECRET="change-me-device-registration-secret"
DEVICE_REGISTRATION_RATE_LIMIT="60"

NEXT_PUBLIC_API_URL="http://localhost:4000"
