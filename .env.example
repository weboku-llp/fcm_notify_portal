# ---------------------------------------------------------------------------
# Root env — copy to .env and adjust. Each app also has its own .env.example,
# but for local dev a single root .env is loaded by all apps.
# ---------------------------------------------------------------------------

# Postgres (matches docker-compose.yml)
DATABASE_URL="postgresql://notif:notif@localhost:5432/notif_portal?schema=public"

# Redis (matches docker-compose.yml — host port 6380 to avoid clashing with a
# local Redis that may already occupy 6379)
REDIS_URL="redis://localhost:6380"

# 32-byte key (base64 or hex) used for AES-256-GCM encryption of service-account
# JSON at rest. Generate with:  node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
PORTAL_ENCRYPTION_KEY="CHANGE_ME_generate_a_32_byte_base64_key_aaaaaaaaaaaaaaa="

# API server
API_HOST="0.0.0.0"
API_PORT="4000"

# Logging: trace|debug|info|warn|error|fatal
LOG_LEVEL="info"

# Use the mocked FCM sender instead of real firebase-admin (great for local dev/tests)
FCM_DRIVER="mock"

# Shared fallback for mobile device registration (X-App-Registration-Key).
# Prefer configuring a per-project registrationSecret in the portal.
# Never put this in NEXT_PUBLIC_* or ship Firebase service-account JSON to clients.
DEVICE_REGISTRATION_SECRET="change-me-device-registration-secret"
DEVICE_REGISTRATION_RATE_LIMIT="60"

# Frontend -> API base URL (never put secrets here)
NEXT_PUBLIC_API_URL="http://localhost:4000"
