# =============================================================================
# apps/api — Railway service name: api
# Paste these into Railway → api → Variables
# =============================================================================

SERVICE=api

# Supabase DATABASE_URL — MUST use Session pooler (IPv4), NOT db.*.supabase.co
# Supabase → Connect → Session pooler. Looks like:
#   postgresql://postgres.tumgmrqscqmrpoxnyxku:PASSWORD@aws-0-<REGION>.pooler.supabase.com:5432/postgres?schema=public&sslmode=require
# Direct db.*.supabase.co:5432 fails on Railway (IPv6-only).
DATABASE_URL=

REDIS_URL=${{Redis.REDIS_URL}}
PORTAL_ENCRYPTION_KEY=
FCM_DRIVER=firebase
DEVICE_REGISTRATION_SECRET=
DEVICE_REGISTRATION_RATE_LIMIT=60
LOG_LEVEL=info
API_HOST=0.0.0.0
API_PORT=4000

# -----------------------------------------------------------------------------
# Local (root .env / apps/api/.env)
# Direct connection works on many home networks (IPv6). Prefer pooler if unsure.
# -----------------------------------------------------------------------------
# DATABASE_URL=postgresql://postgres.PROJECT:PASS@aws-0-REGION.pooler.supabase.com:5432/postgres?schema=public&sslmode=require
# REDIS_URL=redis://localhost:6380
