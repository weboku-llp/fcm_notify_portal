# =============================================================================
# apps/web — Railway service name: web
# =============================================================================

SERVICE=web

# Public API origin — NO trailing slash, NO /api suffix.
# Wrong:  https://notifapi-production.up.railway.app/
# Wrong:  https://notifapi-production.up.railway.app/api
# Right:  https://notifapi-production.up.railway.app
# Must be set at Docker BUILD time (Next.js inlines NEXT_PUBLIC_*).
NEXT_PUBLIC_API_URL=https://notifapi-production.up.railway.app
